// $Id$
// vim:ft=javascript

ARG_ENABLE("printer", "Printer Support", "no");

if (PHP_PRINTER == "yes") {
    EXTENSION("printer", "printer.c");                  // Must be first
    ADD_EXTENSION_DEP("printer", "gd");                  // Now safe — "printer" is registered
    CHECK_LIB("winspool.lib", "printer");                // Required for printer functions
    // Remove gdi32.lib — it's linked automatically on Windows
    AC_DEFINE("HAVE_PRINTER", 1, "Have Printer support");
}